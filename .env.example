# Copy to .env (never committed) to override the dev defaults.
# `pnpm dev` reads it for both the server and Vite's proxy.

# Room server port. Vite proxies /colyseus/* to it, so the browser sees one origin.
PORT=2567

# Interface the Room server binds to. Loopback in dev; 0.0.0.0 inside a container.
# For a phone on the LAN use `pnpm dev --host`: only Vite needs to be reachable.
HOST=127.0.0.1

# Folder for the SQLite data (rooms.sqlite). Defaults to apps/server/data (gitignored).
# Rooms are restored from it on every start. Keep it on a local disk, never NFS/SMB.
# DATA_DIR=/var/lib/universum

# Internal port for /healthz and /readyz (ready once every Room is restored). Never expose it.
# INTERNAL_PORT=9464

# docker compose only: the host port Caddy serves the app on (http://localhost by default).
# HTTP_PORT=80

# Abuse-protection limits (apps/server/src/limits.ts), shown with their defaults. Per-IP limits
# key on X-Real-IP (Caddy sets it), an IPv6 address bucketed by its /64.
# LIMIT_ROOM_CREATIONS_PER_MINUTE=10
# LIMIT_ROOM_CREATIONS_PER_HOUR=60
# LIMIT_OPEN_LOBBIES_PER_IP=15
# LIMIT_JOINS_PER_MINUTE=60
# LIMIT_SEAT_RESERVATIONS_PER_IP=10
# LIMIT_SOCKETS_PER_IP=100
# LIMIT_SEAT_RESERVATION_SECONDS=5
# LIMIT_LIVE_LOBBIES=2000
# LIMIT_PASSWORD_FAILURES_PER_MINUTE=5
# LIMIT_PASSWORD_LOCK_SECONDS=60
# LIMIT_PASSWORD_LOCK_MAX_SECONDS=3600
# LIMIT_PASSWORD_FAILURES_PER_IP=30
# LIMIT_PASSWORD_FAILURES_PER_IP_WINDOW_SECONDS=600
# LIMIT_INTENTS_PER_SECOND=10
# LIMIT_INTENT_FLOOD_CLOSE_SECONDS=5
# LIMIT_INTENT_BURST_CLOSE=50
# LIMIT_MAX_PAYLOAD_BYTES=1024
# LIMIT_MATCHMAKE_BODY_BYTES=2048
