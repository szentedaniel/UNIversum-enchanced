{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import", "promise", "node", "vitest"],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true
  },
  "env": {
    "es2024": true
  },
  // v1/ is the frozen reference implementation; .claude/ and .agents/ are
  // untracked local tooling folders (they may hold other git worktrees).
  "ignorePatterns": [
    "v1/**",
    ".claude/**",
    ".agents/**",
    "**/dist/**",
    "apps/web/src/paraglide/**"
  ],
  "rules": {
    "import/no-cycle": "error",
    // House style: explicit `.ts`/`.tsx` extensions, also where Vite resolves imports.
    "import/extensions": ["error", "always", { "ignorePackages": true, "checkTypeImports": true }],
    "typescript/consistent-type-imports": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error"
  },
  "overrides": [
    {
      "files": ["apps/web/**/*.{ts,tsx}"],
      "plugins": [
        "typescript",
        "unicorn",
        "oxc",
        "import",
        "promise",
        "react",
        "react-perf",
        "jsx-a11y",
        "vitest"
      ],
      "env": { "browser": true },
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/jsx-key": "error",
        "react/react-in-jsx-scope": "off",
        // Inline handlers and `<Route element={<Screen />}>` are idiomatic React
        // (no memoised children here); these two rules would flag every one.
        "react-perf/jsx-no-new-function-as-prop": "off",
        "react-perf/jsx-no-jsx-as-prop": "off",
        // Side-effect imports are only for CSS.
        "import/no-unassigned-import": ["error", { "allow": ["**/*.css"] }],
        // PixiJS `Graphics.fill({ … })` is not `Array.prototype.fill`.
        "unicorn/no-array-fill-with-reference-type": "off",
        // The web app holds no rule logic and no Zod (spec: Modules). It may
        // import only types and the static Board data from rules, and only the
        // Zod-free `messages` subpath from protocol.
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@universum/rules",
                "allowTypeImports": true,
                "message": "The web app may import only types from @universum/rules; static Board data comes from @universum/rules/board."
              },
              {
                "name": "@universum/protocol",
                "message": "The web app may import only @universum/protocol/messages (Zod-free)."
              },
              {
                "name": "zod",
                "message": "Zod stays on the server: the web app gets parsed data from the server's view."
              }
            ],
            "patterns": [
              {
                "group": ["@universum/rules/*", "!@universum/rules/board"],
                "message": "From @universum/rules the web app may import only types and @universum/rules/board."
              },
              {
                "group": ["@universum/protocol/*", "!@universum/protocol/messages"],
                "message": "The web app may import only @universum/protocol/messages (Zod-free)."
              },
              {
                "group": ["zod/*"],
                "message": "Zod stays on the server: the web app gets parsed data from the server's view."
              }
            ]
          }
        ]
      }
    }
  ]
}
