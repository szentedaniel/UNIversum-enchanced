{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["esnext", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    // Paraglide generates JS with JSDoc types (src/paraglide, gitignored).
    "allowJs": true,
    "types": ["vite/client"]
  },
  "include": ["src"],
  // The service worker has its own project and the `webworker` lib
  // (tsconfig.worker.json); its globals would clash with the DOM's.
  "exclude": ["src/pwa/sw.ts"]
}
