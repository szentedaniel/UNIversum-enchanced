{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Tests import app modules (src/players.ts, src/audio.ts) and their browser types.
    "lib": ["esnext", "dom", "dom.iterable"],
    // vite/client: tests import app modules that import assets (src/players.ts).
    "types": ["node", "vite/client"],
    // Tests import Paraglide's generated JS (src/paraglide, gitignored).
    "allowJs": true,
    // Tests import components (test/game-hud.test.ts imports GameHud.tsx).
    "jsx": "react-jsx"
  },
  "include": ["vite.config.ts", "scripts", "test"]
}
