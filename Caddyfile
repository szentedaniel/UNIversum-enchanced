# Stock Caddy in the `web` image: serves the Vite build and proxies the Room
# server, so the browser talks to one origin (plain http, port 80).
:80 {
	encode zstd gzip

	# Colyseus HTTP matchmaking and its WebSockets, prefix stripped, as Vite's
	# dev proxy does. The Room server keys its per-IP limits on X-Real-IP.
	handle_path /colyseus/* {
		reverse_proxy server:2567 {
			header_up X-Real-IP {remote_host}
			header_up -X-Client-IP
		}
	}

	# Error reporting (spec: Observability → Errors): the client's config and
	# the envelope tunnel. Each needs its own handle, or it gets the app shell.
	handle /client-config {
		reverse_proxy server:2567 {
			header_up X-Real-IP {remote_host}
			header_up -X-Client-IP
		}
	}
	handle /errors {
		reverse_proxy server:2567 {
			header_up X-Real-IP {remote_host}
			header_up -X-Client-IP
		}
	}

	# Install surface (spec: Mobile polish and installable PWA): the manifest
	# and the generated icons must not fall through to the app shell. Both have
	# stable URLs, so the manifest is revalidated (a rename or theme change is
	# picked up on the next launch) while the icons get a day; neither is
	# immutable like /assets, whose names carry the content hash.
	handle /manifest.webmanifest {
		root * /srv
		header Content-Type "application/manifest+json"
		header Cache-Control "no-cache"
		file_server
	}
	handle /icons/* {
		root * /srv
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# The service worker (spec: Mobile polish and installable PWA) must be
	# revalidated: the browser only finds a new worker by fetching this stable
	# URL. Its own handle keeps it out of the app-shell cache and the SPA
	# fallback, which would otherwise answer it with index.html.
	handle /sw.js {
		root * /srv
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		header Service-Worker-Allowed "/"
		file_server
	}

	# Source maps are never served (matched before the SPA fallback rewrites the path).
	@sourcemaps path *.map
	handle @sourcemaps {
		respond 404
	}

	handle {
		# Hashed build output can be cached for good; the app shell is revalidated.
		# The manifest and icons have their own handles above and are left out of
		# this matcher, so they keep the cache policy chosen there.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/* /icons/* /manifest.webmanifest /sw.js
		header @shell Cache-Control "no-cache"

		root * /srv
		# Client-side routes (/room/:code, /game/:code, ...) get the app shell.
		try_files {path} /index.html
		file_server
	}
}
