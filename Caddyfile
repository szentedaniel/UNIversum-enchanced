# Stock Caddy in the `web` image: serves the Vite build and proxies the Room
# server, so the browser talks to one origin (plain http, port 80).
:80 {
	encode zstd gzip

	# Colyseus HTTP matchmaking and its WebSockets, prefix stripped, as Vite's
	# dev proxy does. The Room server keys its per-IP limits on X-Real-IP.
	handle_path /colyseus/* {
		reverse_proxy server:2567 {
			header_up X-Real-IP {remote_host}
			header_up -X-Client-IP
		}
	}

	# Error reporting (spec: Observability → Errors): the client's config and
	# the envelope tunnel. Each needs its own handle, or it gets the app shell.
	handle /client-config {
		reverse_proxy server:2567 {
			header_up X-Real-IP {remote_host}
			header_up -X-Client-IP
		}
	}
	handle /errors {
		reverse_proxy server:2567 {
			header_up X-Real-IP {remote_host}
			header_up -X-Client-IP
		}
	}

	# Source maps are never served (matched before the SPA fallback rewrites the path).
	@sourcemaps path *.map
	handle @sourcemaps {
		respond 404
	}

	handle {
		# Hashed build output can be cached for good; the app shell is revalidated.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@shell not path /assets/*
		header @shell Cache-Control "no-cache"

		root * /srv
		# Client-side routes (/room/:code, /game/:code, ...) get the app shell.
		try_files {path} /index.html
		file_server
	}
}
