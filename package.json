{
  "name": "universum",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @universum/server --filter @universum/web run dev",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --type-aware --type-check",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "build": "pnpm --filter @universum/web run build",
    "e2e": "pnpm --filter @universum/e2e run test"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  },
  "packageManager": "pnpm@12.14.0"
}
